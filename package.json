{
  "name": "ashvector-last-signal",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "dev:client": "vinext dev",
    "dev:server": "tsx watch apps/game-server/index.ts",
    "start:server": "tsx apps/game-server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:process": "node tools/assets.mjs process",
    "assets:validate": "node tools/assets.mjs validate",
    "assets:report": "node tools/assets.mjs report",
    "loadtest": "tsx tools/loadtest.ts",
    "format": "prettier --write app game packages apps tests tools/*.ts tools/*.mjs docs *.ts *.json",
    "dev:lan": "node tools/dev.mjs --lan"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "meshoptimizer": "^1.2.0",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
